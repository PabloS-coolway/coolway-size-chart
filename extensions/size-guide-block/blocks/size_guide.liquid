{%- comment -%}
  Guía de tallas — App Block (Theme App Extension).

  Tarea 3.2 (change: size-guide-app-block-base): esqueleto base.
  Tarea 3.3 (change: size-guide-storefront-read): lectura del metaobject
  referenciado vía Liquid nativo (sin Storefront GraphQL explícita).
  Tarea 3.4 (change: size-guide-render-blocks): renderizado real de cada
  tipo de bloque (tabla/texto/imagen/vídeo). Todavía NO es el modal/overlay
  interactivo final (decisión UX 3.1) — aquí solo se genera el HTML de
  contenido que iría dentro; el modal en sí es trabajo aparte.

  NOTA (hallazgo real 3.2): Shopify envuelve SIEMPRE este bloque en su
  propio contenedor (`shopify-block shopify-app-block`), que reserva
  espacio en la sección aunque el bloque no renderice nada dentro.
  Solución: CSS `:has()` para colapsar ese contenedor cuando nuestro <div>
  interno está vacío. `{% stylesheet %}` no está permitido en blocks de
  Theme App Extension — el CSS va en un `<style>` inline normal.

  NOTA (hallazgo real 3.3): la resolución nativa de metaobjects en Liquid
  funciona sin más gracias al acceso `storefront: PUBLIC_READ` de la 1.4.

  NOTA (hallazgos reales 3.4, ver docs/render-blocks.md):
  - `resolved_guide.blocks` (sin `.value`) da la lista CRUDA de GIDs sin
    resolver. Hay que acceder a `.value` (`resolved_guide.blocks.value`,
    un `MetaobjectListDrop`) para iterar los metaobjects ya resueltos.
  - Ese `.value` SOLO incluye los bloques en estado Active — un bloque en
    Draft desaparece de la lista sin más (probado con una guía real que
    tenía 4 de 5 bloques en Draft: `.value` solo devolvió el activo).
  - `block.type` viene vacío en este contexto (no sirve para el `{% case %}`
    que se intentó primero) — el tipo de cada bloque se detecta por la
    presencia de su campo distintivo (`headers`/`content`/`image`/
    `video_url`), no por `.type`.
  - Campos JSON (`headers`, `rows`) y de texto enriquecido (`content`,
    `description`) necesitan `.value` para obtener la estructura Liquid ya
    parseada (array/hash nativo) — el acceso directo (sin `.value`) da el
    JSON en bruto sin parsear. No existe el filtro `parse_json` en el
    Liquid de Shopify.
  - Campos de texto plano (`label`, `unit_primary`) SÍ funcionan con acceso
    directo, sin `.value`.
  - Imagen (`image`) y vídeo (`video_url`) se han implementado siguiendo el
    mismo patrón de `.value` para referencias, pero NO se han podido
    validar con datos reales en esta tarea: la única guía de prueba con
    contenido Active era la de tabla — sus bloques de imagen/texto estaban
    en Draft. Queda como pendiente de validación cuando haya un bloque de
    ese tipo en estado Active.

  NOTA (hallazgos reales 3.6, ver docs/unit-auto-select.md):
  - `localization.country.iso_code` es la fuente elegida (ver design.md) para
    decidir cuál unidad se marca por defecto en tablas con
    `has_dual_unit_selector`. No se oculta ninguna unidad; solo se marca
    visualmente cuál es "la del visitante".
  - Lista cerrada de países de sistema imperial: US, LR, MM. Cualquier otro
    país (incluido cuando `iso_code` no resuelve) usa cm como unidad por
    defecto (fallback seguro).
{%- endcomment -%}

{%- assign coolway_imperial_countries = 'US,LR,MM' | split: ',' -%}
{%- assign coolway_imperial_first = false -%}
{%- if localization.country.iso_code and coolway_imperial_countries contains localization.country.iso_code -%}
  {%- assign coolway_imperial_first = true -%}
{%- endif -%}

{%- comment -%}
  Tarea 3.7 (change: size-guide-rtl-support): dirección de texto según el
  IDIOMA real de la visita (request.locale), no el mercado — lista cerrada
  de idiomas RTL (árabe, hebreo, persa/farsi, urdu). Ver design.md.
{%- endcomment -%}
{%- assign coolway_rtl_languages = 'ar,he,fa,ur' | split: ',' -%}
{%- assign coolway_text_dir = 'ltr' -%}
{%- if request.locale.iso_code and coolway_rtl_languages contains request.locale.iso_code -%}
  {%- assign coolway_text_dir = 'rtl' -%}
{%- endif -%}

{%- assign resolved_guide = product.metafields.custom.resolved_size_guide.value -%}

<div class="coolway-size-guide-block" dir="{{ coolway_text_dir }}">
  {%- if resolved_guide -%}
    {%- assign coolway_modal_id = 'coolway-size-guide-modal-' | append: block.id -%}
    {%- assign coolway_size_guide_link_text = 'general.block_name' | t -%}
    <a href="#" class="coolway-size-guide-block__trigger" aria-haspopup="dialog" aria-controls="{{ coolway_modal_id }}" data-coolway-size-guide-trigger>{{ coolway_size_guide_link_text }}</a>

    <div class="coolway-size-guide-block__modal" id="{{ coolway_modal_id }}" role="dialog" aria-modal="true" aria-label="{{ coolway_size_guide_link_text }}" hidden data-coolway-size-guide-modal>
      <div class="coolway-size-guide-block__modal-backdrop" data-coolway-size-guide-close></div>
      <div class="coolway-size-guide-block__modal-panel">
        <div class="coolway-size-guide-block__modal-header">
          <div class="coolway-size-guide-block__modal-header-text">
            <span class="coolway-size-guide-block__modal-title">{{ product.title }}</span>
            <span class="coolway-size-guide-block__modal-subtitle">{{ 'general.block_name' | t }}</span>
          </div>
          <button type="button" class="coolway-size-guide-block__modal-close" aria-label="{{ 'general.close' | t }}" data-coolway-size-guide-close></button>
        </div>
        <div class="coolway-size-guide-block__content">
      {%- if resolved_guide.description.value != blank -%}
        {%- capture coolway_description_html -%}
          {%- render 'coolway-rich-text', value: resolved_guide.description.value -%}
        {%- endcapture -%}
        {%- assign coolway_description_text = coolway_description_html | strip_html | strip -%}
        {%- if coolway_description_text != blank -%}
          <div class="coolway-size-guide-block__description">{{ coolway_description_html }}</div>
        {%- endif -%}
      {%- endif -%}

      {%- for block in resolved_guide.blocks.value -%}

        {%- if block.headers != blank and block.rows != blank and block.hide_table != true -%}
          {%- assign headers = block.headers.value -%}
          {%- assign rows = block.rows.value -%}
          {%- capture coolway_group_label -%}
            {{ block.label }}
            {%- if block.has_dual_unit_selector -%}
              {%- if coolway_imperial_first %} (<span class="coolway-size-guide-block__unit--default">{{ block.unit_secondary }}</span> / {{ block.unit_primary }})
              {%- else %} (<span class="coolway-size-guide-block__unit--default">{{ block.unit_primary }}</span> / {{ block.unit_secondary }})
              {%- endif -%}
            {%- elsif block.unit_primary != blank %} ({{ block.unit_primary }})
            {%- endif -%}
          {%- endcapture -%}
          <div class="coolway-size-guide-block__table-outer">
            <div class="coolway-size-guide-block__table-wrap">
              <div class="coolway-size-guide-block__table-scroll">
                <table class="coolway-size-guide-block__table">
                  <thead>
                    {%- assign coolway_group_stripped = coolway_group_label | strip -%}
                    {%- if coolway_group_stripped != blank -%}
                      <tr class="coolway-size-guide-block__table-group-row">
                        <th colspan="{{ headers.size }}">{{ coolway_group_stripped }}</th>
                      </tr>
                    {%- endif -%}
                    <tr class="coolway-size-guide-block__table-header-row">
                      {%- for header in headers -%}
                        <th>{{ header }}</th>
                      {%- endfor -%}
                    </tr>
                  </thead>
                  <tbody>
                    {%- for row in rows -%}
                      <tr>
                        {%- for cell in row -%}
                          <td>{{ cell }}</td>
                        {%- endfor -%}
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            </div>
            {%- if block.footer_text != blank -%}
              <p class="coolway-size-guide-block__table-footer">{{ block.footer_text }}</p>
            {%- endif -%}
          </div>

        {%- elsif block.content.value != blank -%}
          <div class="coolway-size-guide-block__text">
            {%- render 'coolway-rich-text', value: block.content.value -%}
          </div>

        {%- elsif block.image != blank -%}
          <figure class="coolway-size-guide-block__image">
            <img
              src="{{ block.image | image_url: width: 800 }}"
              alt="{{ block.alt_text | escape }}"
              width="800"
              height="{{ block.image.height | times: 800 | divided_by: block.image.width }}"
              loading="lazy"
            >
            {%- if block.caption != blank -%}
              <figcaption>{{ block.caption }}</figcaption>
            {%- endif -%}
          </figure>

        {%- elsif block.video_url != blank -%}
          <figure class="coolway-size-guide-block__video">
            <video src="{{ block.video_url }}" controls></video>
            {%- if block.caption != blank -%}
              <figcaption>{{ block.caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}

      {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

<style>
  .shopify-block:has(> .coolway-size-guide-block:empty) {
    display: none;
  }
  .coolway-size-guide-block__unit--default {
    font-weight: 700;
  }
  /* ---- Modal: réplica del estilo "glass" de Kiwi en coolway.com ---- */
  .coolway-size-guide-block__modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    color: rgba(255, 255, 255, 0.94);
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-style: normal;
    font-variant-numeric: tabular-nums;
  }
  .coolway-size-guide-block__modal[hidden] {
    display: none;
  }
  .coolway-size-guide-block__modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px) saturate(104%) brightness(1.01);
    -webkit-backdrop-filter: blur(6px) saturate(104%) brightness(1.01);
  }
  .coolway-size-guide-block__modal-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(720px, calc(100vw - 56px));
    max-height: calc(100dvh - 20px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    background:
      radial-gradient(circle at 12% 0%, rgba(255, 255, 255, 0.18), transparent 38%),
      linear-gradient(145deg, rgba(68, 68, 74, 0.66), rgba(34, 34, 39, 0.56));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.16), 0 22px 64px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(28px) saturate(126%) brightness(1.08);
    -webkit-backdrop-filter: blur(28px) saturate(126%) brightness(1.08);
    text-align: start;
  }
  .coolway-size-guide-block__modal-header {
    position: relative;
    flex: 0 0 auto;
    min-height: 80px;
    padding: 22px 78px 18px 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px 18px 0 0;
    background: rgba(255, 255, 255, 0.055);
    backdrop-filter: blur(22px) saturate(135%);
    -webkit-backdrop-filter: blur(22px) saturate(135%);
  }
  .coolway-size-guide-block__modal-header-text {
    display: block;
  }
  .coolway-size-guide-block__modal-title {
    display: block;
    margin: 0;
    color: rgba(255, 255, 255, 0.96);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .coolway-size-guide-block__modal-subtitle {
    display: block;
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.56);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.35;
    opacity: 1;
  }
  .coolway-size-guide-block__modal-close {
    position: absolute;
    top: 21px;
    right: 22px;
    display: block;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.09);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.13);
    color: transparent;
    font-size: 0;
    cursor: pointer;
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
  }
  .coolway-size-guide-block__modal-close:hover {
    background: rgba(255, 255, 255, 0.15);
  }
  .coolway-size-guide-block__modal-close::before,
  .coolway-size-guide-block__modal-close::after {
    content: "";
    position: absolute;
    top: 20px;
    left: 12px;
    width: 18px;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.9);
  }
  .coolway-size-guide-block__modal-close::before { transform: rotate(45deg); }
  .coolway-size-guide-block__modal-close::after { transform: rotate(-45deg); }
  .coolway-size-guide-block__content {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 26px 30px 28px;
    color: rgba(255, 255, 255, 0.9);
  }
  .coolway-size-guide-block__description {
    margin-bottom: 20px;
    padding: 13px 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.09);
    color: rgba(255, 255, 255, 0.9);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
  }
  .coolway-size-guide-block__description p,
  .coolway-size-guide-block__text p { margin: 0 0 0.6em; }
  .coolway-size-guide-block__description p:last-child,
  .coolway-size-guide-block__text p:last-child { margin-bottom: 0; }
  .coolway-size-guide-block__description *,
  .coolway-size-guide-block__text *,
  .coolway-size-guide-block__table-footer,
  .coolway-size-guide-block figcaption { color: inherit; }
  .coolway-size-guide-block__table-outer {
    margin-bottom: 20px;
  }
  .coolway-size-guide-block__table-wrap {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.067);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 14px 36px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(22px) saturate(130%);
    -webkit-backdrop-filter: blur(22px) saturate(130%);
  }
  .coolway-size-guide-block__table-scroll {
    overflow-x: auto;
  }
  .coolway-size-guide-block__table {
    width: 100%;
    min-width: 0;
    border-collapse: collapse;
    background: transparent;
  }
  .coolway-size-guide-block__table th,
  .coolway-size-guide-block__table td {
    height: 42px;
    padding: 0 10px;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.075);
    color: rgba(255, 255, 255, 0.9);
    font-family: inherit;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
  }
  .coolway-size-guide-block__table tr > :last-child { border-right: 0; }
  .coolway-size-guide-block__table tbody tr:last-child td { border-bottom: 0; }
  .coolway-size-guide-block__table-group-row th {
    height: 38px;
    background: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.97);
    font-size: 12px;
    font-weight: 500;
  }
  .coolway-size-guide-block__table-header-row th {
    background: rgba(255, 255, 255, 0.094);
    color: rgba(255, 255, 255, 0.78);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.015em;
  }
  .coolway-size-guide-block__table tbody td:first-child {
    color: rgba(255, 255, 255, 0.96);
    font-weight: 500;
  }
  .coolway-size-guide-block__table tbody tr:hover td {
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.96);
  }
  .coolway-size-guide-block__table-footer {
    margin: 10px 4px 0;
    color: rgba(255, 255, 255, 0.56);
    font-size: 12px;
    line-height: 1.4;
  }
  .coolway-size-guide-block__text {
    margin-bottom: 20px;
    padding: 13px 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.09);
    color: rgba(255, 255, 255, 0.9);
    font-size: 13px;
    line-height: 1.45;
  }
  .coolway-size-guide-block__image,
  .coolway-size-guide-block__video {
    margin: 0 0 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.067);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 14px 36px rgba(0, 0, 0, 0.1);
  }
  .coolway-size-guide-block__image img,
  .coolway-size-guide-block__video video {
    display: block;
    width: 100%;
    height: auto;
  }
  .coolway-size-guide-block__image figcaption,
  .coolway-size-guide-block__video figcaption {
    padding: 10px 14px;
    color: rgba(255, 255, 255, 0.56);
    font-size: 12px;
    line-height: 1.4;
  }
  .coolway-size-guide-block__content > :last-child { margin-bottom: 0; }
  /* Scroll funcional pero sin barra visible (como en coolway.com) */
  .coolway-size-guide-block__content,
  .coolway-size-guide-block__table-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .coolway-size-guide-block__content::-webkit-scrollbar,
  .coolway-size-guide-block__table-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
  @media (max-width: 640px) {
    .coolway-size-guide-block__modal {
      align-items: flex-end;
    }
    .coolway-size-guide-block__modal-backdrop {
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(5px) saturate(103%) brightness(1.01);
      -webkit-backdrop-filter: blur(5px) saturate(103%) brightness(1.01);
    }
    .coolway-size-guide-block__modal-panel {
      width: 100%;
      max-height: 91dvh;
      border-radius: 18px 18px 0 0;
    }
    .coolway-size-guide-block__modal-header {
      padding: 20px 68px 18px 22px;
    }
    .coolway-size-guide-block__modal-title { font-size: 16px; }
    .coolway-size-guide-block__modal-close { top: 17px; right: 16px; }
    .coolway-size-guide-block__content {
      padding: 18px 16px calc(24px + env(safe-area-inset-bottom));
    }
    .coolway-size-guide-block__description,
    .coolway-size-guide-block__text { margin-bottom: 15px; padding: 12px 14px; border-radius: 16px; }
    .coolway-size-guide-block__table th,
    .coolway-size-guide-block__table td { font-size: 12px; padding: 0 6px; }
    .coolway-size-guide-block__table-header-row th { font-size: 10px; }
  }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-coolway-size-guide-trigger]').forEach(function (trigger) {
      var modal = document.getElementById(trigger.getAttribute('aria-controls'));
      if (!modal) return;

      // Hallazgo real (3.13): el bloque vive dentro de contenedores del
      // tema con su propio contexto de apilamiento (p. ej.
      // `.product-details.sticky-content--desktop`, position: sticky,
      // z-index: 1) que "atrapa" nuestro z-index alto por debajo del
      // header del tema. Se mueve el modal a document.body para que
      // quede fuera de ese contexto y cubra siempre toda la página.
      //
      // Hallazgo real (encontrado validando 3.12): al mover el modal a
      // document.body pierde la herencia de `dir` del contenedor raíz
      // del bloque (RTL de la 3.7), porque `dir` no viaja con el nodo,
      // se hereda del árbol donde queda insertado. Se copia explícitamente
      // el `dir` del bloque raíz al propio modal antes/al moverlo.
      var coolwayRootBlock = trigger.closest('.coolway-size-guide-block');
      if (coolwayRootBlock) {
        modal.setAttribute('dir', coolwayRootBlock.getAttribute('dir') || 'ltr');
      }
      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }

      function openModal(event) {
        event.preventDefault();
        modal.hidden = false;
        var closeButton = modal.querySelector('.coolway-size-guide-block__modal-close');
        if (closeButton) closeButton.focus();
        document.addEventListener('keydown', onKeydown);
      }

      function closeModal() {
        modal.hidden = true;
        trigger.focus();
        document.removeEventListener('keydown', onKeydown);
      }

      function onKeydown(event) {
        if (event.key === 'Escape') closeModal();
      }

      trigger.addEventListener('click', openModal);
      modal.querySelectorAll('[data-coolway-size-guide-close]').forEach(function (closer) {
        closer.addEventListener('click', closeModal);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "t:general.block_name",
  "target": "section"
}
{% endschema %}
